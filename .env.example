# Klucz modelu językowego. Zostaw puste — aplikacja działa na wbudowanym katalogu.
# Nie dodawaj przedrostka NEXT_PUBLIC_. Klucz ma zostać tylko na serwerze.
LLM_API_KEY=

# openai: API zgodne z OpenAI (OpenAI, OpenRouter, Groq, Ollama).
# anthropic: API Anthropic Messages.
LLM_PROVIDER=openai

# Adres bez końcówki /chat/completions.
LLM_API_BASE=https://api.openai.com/v1

# Nazwa modelu u wybranego dostawcy.
LLM_MODEL=gpt-4o-mini

# Gdy LLM_PROVIDER=openai i LLM_API_KEY jest puste, honorowany jest też OPENAI_API_KEY.
# OPENAI_API_KEY=
